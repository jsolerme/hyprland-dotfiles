{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "windows",
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta"
    },
    "size": {
      "ndigits": 0,
      "maxPrefix": "MB"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "green",
        "at": "red",
        "host": "blue"
      }
    },
    "break",
    {
      "type": "os",
      "key": "",
      "keyColor": "blue"
    },
    {
      "type": "host",
      "key": "",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "",
      "keyColor": "white"
    },
    {
      "type": "shell",
      "key": "",
      "keyColor": "cyan"
    },
    "break",
    {
      "type": "locale",
      "key": "",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "display",
      "key": "󰍹",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "",
      "keyColor": "magenta"
    },
    "break",
    {
      "type": "cpu",
      "key": "",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "",
      "keyColor": "green"
    },
    "break",
    "colors",
    "break"
  ]
}